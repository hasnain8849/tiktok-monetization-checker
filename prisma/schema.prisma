// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // bcrypt hash; null for legacy / OAuth-only users
  role      String   @default("user") // "user" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cached TikTok profile lookups so re-checks are instant.
model CachedProfile {
  id              String   @id
  handle          String   @unique
  displayName     String
  avatarInitials  String
  bio             String   @default("")
  url             String
  verified        Boolean  @default(false)
  region          String   @default("")
  category        String   @default("")
  accountAgeDays   Int      @default(0)
  followers       Int      @default(0)
  following       Int      @default(0)
  likes           Int      @default(0)
  videos          Int      @default(0)
  engagementRate  Float    @default(0)
  avgViewsPerVideo Int     @default(0)
  monetizationEligible Boolean @default(false)
  checksJson      String   @default("[]") // serialized EligibilityCheck[]
  recentVideosJson String @default("[]")
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
}

// Audit history saved by the user from the dashboard.
model SavedAudit {
  id              String   @id @default(cuid())
  userId          String?
  handle          String
  avatarInitials  String
  followers       Int
  eligible        Boolean
  status          String   // "eligible" | "ineligible" | "restricted"
  checksPassed    Int
  checksTotal     Int
  checkedAt       DateTime @default(now())
}

// Tracks profiles that paid the unlock fee after being flagged as restricted.
// Once a row exists for a given handle, the audit will treat the profile as eligible.
model UnlockedProfile {
  id              String   @id @default(cuid())
  handle          String   @unique
  userId          String?
  feeAmount       Float    @default(49.0)
  currency        String   @default("USD")
  paymentMethod    String   @default("bank_transfer")
  paymentRef       String?  // user-supplied reference / transaction id
  paidAt           DateTime @default(now())
}

// Payment attempts — used by the /api/payments route to record each attempt.
model PaymentAttempt {
  id              String   @id @default(cuid())
  handle          String
  userId          String?
  amount          Float
  currency        String   @default("USD")
  paymentRef      String
  status          String   @default("pending") // pending | verified | rejected
  createdAt       DateTime @default(now())
}

// Audit log — every admin action (verify / reject / promote) is recorded here
// with the actor's email, the action taken, and the target (handle / userId).
model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String   // who performed the action
  action      String   // "verify_payment" | "reject_payment" | "promote_user" | ...
  targetType  String   // "payment" | "user" | ...
  targetId    String?  // the resource id (PaymentAttempt.id, User.id, ...)
  targetHandle String? // for payments, the handle being unlocked
  metadata    String   @default("{}") // JSON blob for extra context
  createdAt   DateTime @default(now())
}

// Outbound emails — every sendEmail() call writes a row here so the admin
// can audit every email we sent to users.
model EmailLog {
  id               String   @id @default(cuid())
  to               String
  subject          String
  body             String
  tag              String?  // e.g., "payment_verified"
  provider         String   // "console" | "smtp"
  status           String   // "sent" | "failed"
  providerMessageId String?
  error            String?
  createdAt        DateTime @default(now())
}

// Webhook delivery attempts — tracks every call to the payment-notifier
// mini-service. The notifyPaymentUpdate() helper records one row per
// attempt with status + retry count + next retry timestamp, so we can
// retry on transient failures.
model WebhookDelivery {
  id              String   @id @default(cuid())
  handle          String
  attemptId       String?  // the PaymentAttempt.id this notification is about
  status          String   // "pending" | "delivered" | "failed"
  attemptCount    Int      @default(0)
  lastError       String?
  nextRetryAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Per-user notification preferences. Defaults to all-on. Users can opt
// out of eligibility alerts (e.g., the cron re-audit emails) or payment
// emails individually, and can opt out of alerts for specific handles.
model NotificationSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  paymentEmailsEnabled   Boolean  @default(true)
  eligibilityAlertsEnabled Boolean @default(true)
  // JSON array of handles the user has muted (no eligibility-alert emails).
  mutedHandlesJson        String   @default("[]")
  updatedAt               DateTime @updatedAt
}

// TOTP two-factor auth secrets. One row per user. The `secret` is the
// base32-encoded TOTP seed stored in plaintext (suitable for sandboxed
// demos; in production encrypt at rest with a KMS-managed key). The
// `verifiedAt` field is null until the user confirms a 6-digit code.
model TwoFactor {
  id         String   @id @default(cuid())
  userId     String   @unique
  secret     String   // base32 TOTP secret
  backupCodes String  @default("[]") // JSON array of one-time backup codes
  verifiedAt DateTime?  // null until the user confirms a TOTP code
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
