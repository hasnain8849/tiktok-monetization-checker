# Copy this file to .env and fill in the values

DATABASE_URL=file:./db/custom.db

# NextAuth (generate a random 64-char string for NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Payment provider: "simulated" (default) or "stripe"
PAYMENT_PROVIDER=simulated

# Stripe keys (only needed if PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email provider: "console" (default, logs to stdout) or "smtp"
EMAIL_PROVIDER=console

# SMTP settings (only needed if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=password
# SMTP_FROM=no-reply@example.com

# Cron job bearer token (use a strong random string)
CRON_SECRET=your-cron-secret-here

# Audit retention days (default 90)
# AUDIT_RETENTION_DAYS=90
